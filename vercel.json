import { useState } from "react";

const API = import.meta.env.VITE_API_URL || "http://localhost:8000";

export default function Results({ clips, onReset }) {
  const [playing, setPlaying] = useState(null);

  const formatDuration = (s) => {
    const m = Math.floor(s / 60);
    const sec = Math.round(s % 60);
    return `${m}:${sec.toString().padStart(2, "0")}`;
  };

  const formatTimestamp = (s) => {
    const m = Math.floor(s / 60);
    const sec = Math.round(s % 60);
    return `${m}m ${sec}s`;
  };

  return (
    <div className="results">
      <div className="results-header">
        <h2 className="results-title">✅ {clips.length} Clips Ready!</h2>
        <button className="reset-btn" onClick={onReset}>+ New Video</button>
      </div>

      <div className="clips-grid">
        {clips.map((clip) => (
          <div key={clip.index} className="clip-card">
            <div className="clip-number">Clip {clip.index}</div>

            <video
              className="clip-video"
              src={`${API}${clip.url}`}
              controls
              preload="metadata"
              onPlay={() => setPlaying(clip.index)}
            />

            <div className="clip-meta">
              <span className="clip-timestamp">
                ⏱ {formatTimestamp(clip.start)} → {formatTimestamp(clip.end)}
              </span>
              <span className="clip-duration">🎬 {formatDuration(clip.duration)}</span>
            </div>

            <div className="clip-actions">
              <a
                className="download-btn"
                href={`${API}/download/0/${clip.name}`.replace("/download/0/", `/download/${clip.url.split("/")[2]}/`)}
                download={clip.name}
              >
                ⬇ Download
              </a>
              <button
                className="share-btn"
                onClick={() => {
                  const url = `${API}${clip.url}`;
                  navigator.clipboard.writeText(url);
                  alert("Link copied! Share it anywhere 🎉");
                }}
              >
                🔗 Copy Link
              </button>
            </div>
          </div>
        ))}
      </div>

      <div className="tips">
        <h3>💡 Tips for Sharing</h3>
        <ul>
          <li>📱 Instagram Reels — best under 90 seconds</li>
          <li>🎵 YouTube Shorts — best under 60 seconds</li>
          <li>🐦 Twitter/X — best under 2 minutes 20 seconds</li>
          <li>💼 LinkedIn — 30–90 seconds performs best</li>
        </ul>
      </div>
    </div>
  );
}
