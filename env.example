import { useState } from "react";
import Uploader from "./components/Uploader";
import Processing from "./components/Processing";
import Results from "./components/Results";
import "./App.css";

export default function App() {
  const [phase, setPhase] = useState("upload"); // upload | processing | results
  const [jobId, setJobId] = useState(null);
  const [clips, setClips] = useState([]);

  const handleJobStart = (id) => {
    setJobId(id);
    setPhase("processing");
  };

  const handleDone = (clipsData) => {
    setClips(clipsData);
    setPhase("results");
  };

  const handleReset = () => {
    setPhase("upload");
    setJobId(null);
    setClips([]);
  };

  return (
    <div className="app">
      <header className="header">
        <div className="logo">
          <span className="logo-icon">✂</span>
          <span className="logo-text">ClipForge</span>
        </div>
        <p className="tagline">Turn long videos into viral short clips — powered by AI</p>
      </header>

      <main className="main">
        {phase === "upload" && <Uploader onJobStart={handleJobStart} />}
        {phase === "processing" && <Processing jobId={jobId} onDone={handleDone} />}
        {phase === "results" && <Results clips={clips} onReset={handleReset} />}
      </main>

      <footer className="footer">
        <p>ClipForge © 2025 · Built with FastAPI + Whisper + React</p>
      </footer>
    </div>
  );
}
